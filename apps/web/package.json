{
  "name": "@backy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && printf '%s\\n' '# Build output from `bun --cwd apps/web build` (vite outputs here).' '# Worker [assets] picks it up at deploy time; never commit.' '*' '!.gitignore' > ../worker/static/.gitignore",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings --no-errors-on-unmatched src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@backy/api": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.40.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "happy-dom": "20.14.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
