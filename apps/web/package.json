{
  "name": "@backy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && printf '%s\\n' '# Build output from `bun --cwd apps/web build` (vite outputs here).' '# Worker [assets] picks it up at deploy time; never commit.' '*' '!.gitignore' > ../worker/static/.gitignore",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings --no-errors-on-unmatched src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@backy/api": "workspace:*",
    "@nocoo/basalt": "^3.6.0",
    "clsx": "^2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "recharts": "^3.11.0",
    "swr": "^2.5.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "happy-dom": "21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
