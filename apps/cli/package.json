{
  "name": "@backy/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "backy": "./src/bin.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 src",
    "lint:staged": "lint-staged",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "lint-staged": "^17.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.ts": "eslint --max-warnings=0 --no-warn-ignored"
  }
}
