{
  "name": "@backy/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "backy": "./src/bin.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 src",
    "lint:staged": "lint-staged",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.ts": "eslint --max-warnings=0 --no-warn-ignored"
  }
}
