{
  "name": "@backy/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 7018",
    "build": "echo 'apps/worker has no build step (wrangler bundles at deploy)' && exit 0",
    "deploy": "wrangler deploy",
    "lint": "eslint --max-warnings=0 src",
    "lint:staged": "lint-staged",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@backy/api": "workspace:*",
    "hono": "^4.12.28",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260706.1",
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "lint-staged": "^17.0.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "^4.1.10",
    "wrangler": "4.107.1"
  },
  "lint-staged": {
    "*.ts": "eslint --max-warnings=0 --no-warn-ignored"
  }
}
