{
  "name": "@backy/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 7018",
    "build": "echo 'apps/worker has no build step (wrangler bundles at deploy)' && exit 0",
    "deploy": "wrangler deploy",
    "lint": "biome check --error-on-warnings --no-errors-on-unmatched src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@backy/api": "workspace:*",
    "hono": "^4.13.1",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.122.0"
  }
}
